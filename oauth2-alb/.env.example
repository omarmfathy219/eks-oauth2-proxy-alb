# Copy to .env and fill in. Nothing here is committed.
export CLUSTER_NAME=speedrun-demo
export AWS_REGION=us-east-1
export APP_HOST=app.example.com                     # the DNS name the ALB answers on
export CERT_ARN=arn:aws:acm:us-east-1:111122223333:certificate/REPLACE
export OIDC_ISSUER=https://your-idp.example.com     # no trailing slash
export OIDC_CLIENT_ID=replace-me
export OIDC_CLIENT_SECRET=replace-me
# Solution 2 only: ALB calls these directly
export OIDC_AUTHORIZATION_ENDPOINT=${OIDC_ISSUER}/authorize
export OIDC_TOKEN_ENDPOINT=${OIDC_ISSUER}/oauth/token
export OIDC_USERINFO_ENDPOINT=${OIDC_ISSUER}/userinfo
